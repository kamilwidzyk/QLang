{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "QLang",
	"patterns": [
		{ "include": "#comments"},
		{ "include": "#strings" },
		{ "include": "#semicolon"},
		{ "include": "#numbers"},
		{ "include": "#function_calls"},
		{ "include": "#constant"},
		{ "include": "#operators" },
		{ "include": "#storage" },
		{ "include": "#keywords_control"},
		{ "include": "#keywords_function"},
		{ "include": "#builtin_functions" }
	],
	"repository": {
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.mylang",
					"match": "(#|\\+\\+|--|\\+=|-=|\\*=|/=|\\*\\*=|==|!=|>=|<=|\\*\\*|=|\\+|-|\\*|/|<|>|!|&|\\||&=|\\|=|%|%=)"
				}
			]
		},
		"builtin_functions":{
			"patterns": [
				{
					"name": "support.function",
					"match": "\\b(print|println|input|debug|range|parent|\\.\\.)\\b"
				}
			]
		},
		"keywords_control": {
			"patterns": [
				{
					"name": "keyword.control.qlang",
					"match": "\\b(if|else if|elif|else|while|for|from|to|step|return|break|continue)\\b"
				}
			]
		},
		"keywords_function": {
			"patterns": [
				{
					"name": "keyword.declaration.function.qlang",
					"match": "\\b(function|place)\\b"
				}
			]
		},
		"storage": {
			"patterns": [
				{
					"name": "storage.type",
					"match": "\\b(num|obs|state)\\b"
				}
			]
		},
		"constant": {
			"patterns": [
				{
					"name": "constant.language",
					"match": "\\b(T|F|DEC|HEX|BIN)\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.qlang",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.qlang",
					"match": "\\\\."
				},
				{
					"name": "string.interpolation.qlang",
					"match": "%(?:[-+#0 ]*(?:\\d+|\\*)?(?:\\.\\d+|\\.\\*)?[hlL]?[diouxXeEfFgGcspn%])"
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.qlang",
			"match": "\\b(0x[0-9a-fA-F]+|0b[01]+|[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?|\\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|[0-9]+)\\b"
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.qlang",
					"match": "//.*$"
				},
				{
					"name": "comment.block.qlang",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"semicolon": {
			"name": "punctuation.terminator.statement.qlang",
			"match": ";"
		},
		"function_calls": {
			"begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
			"beginCaptures": {
				"1": { "name": "entity.name.function.qlang" }
			},
			"end": "\\)",
			"patterns": [
				{ "include": "#strings" },
				{ "include": "#numbers" },
				{ "include": "#named_args" },
				{ "include": "#operators" }
			]
		},
		"named_args": {
			"patterns": [
				{
					"name": "variable.parameter.named.qlang",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\s*=)"
				}
			]
		}
	},
	"scopeName": "source.qlang"
}