println("This is a string");
println("This is a string + a number: " + 42);
println("This is a string + a list: " + [1, 2, 3]);
println("This is a string + a list of strings: " + ["a", "b", "c"]);
println(42 + " is a number + a string");
println([1, 2, 3] + " is a list + a string");
println(["a", "b", "c"] + " is a list of strings + a string");
println("This is a string " + "concatenated with another string");
println("This is a string " + "concatenated with a list: " + [1, 2, 3]);
println("This is a string and a mixed list: " + [1, "two", 3.0]);
println("This is a string and a nested list: " + [1, [2, 3], 4]);
println("This is a string and a nested list of strings: " + ["a", ["b", "c"], "d"]);
println("This is a string " + ["a", "b", "c"] + " concatenated with a list and another string");

num x = 10;
println("The value of x is: " + x);

num y = 3.14;
println("The value of y is: " + y);

obs a = 1;
println("The value of a is: " + a);

obs b[5] = 8;
println("The value of b is: " + (b >> num));

text s = "Hello, World!";
println("The value of s is: " + s);

num z = [1, 2, 3, 4.0];
println("The value of z is: " + z);

num nested_list = [1, [2, 3], 4];
println("The value of nested_list is: " + nested_list);





